const fmtAddress = (o?: {
    addressLine1?: string;
    addressLine2?: string;
    addressLine3?: string;
}) => {
    if (!o) return "";
    const full = [o.addressLine1, o.addressLine2, o.addressLine3]
        .filter(Boolean)
        .join(", ");
    if (!full) return "";
    const parts = full.split(",");
    if (parts.length <= 1) return full;
    const last = parts.pop()!.trim();
    const first = parts.join(",");
    return `${first},\n${last}`;
};

const splitFirstTimestamp = (line: string | null) => {
    if (!line) return null;
    const idx = line.search(/\d/);
    if (idx <= 0) return null;
    const head = line.slice(0, idx).trimEnd();
    const tail = line.slice(idx).trim();
    return { head, tail };
};

