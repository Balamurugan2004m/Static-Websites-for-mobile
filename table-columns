/** MUI X `type: 'date'` columns require `Date` values; API rows often use ISO strings. */
const toGridDate = (value: unknown): Date | null => {
    if (value == null || value === "") return null;
    if (value instanceof Date) {
        return Number.isNaN(value.getTime()) ? null : value;
    }
    const d = new Date(String(value));
    return Number.isNaN(d.getTime()) ? null : d;
};

const formatDateToDDMMYYYY = (val: unknown): string => {
    if (!val) return "";
    const trimmed = String(val).split("T")[0].trim();
    const dashParts = trimmed.split("-");
    if (dashParts.length === 3) {
        if (dashParts[0].length === 4) {
            return `${dashParts[2].padStart(2, "0")}/${dashParts[1].padStart(2, "0")}/${dashParts[0]}`;
        }
        if (dashParts[2].length === 4) {
            return `${dashParts[0].padStart(2, "0")}/${dashParts[1].padStart(2, "0")}/${dashParts[2]}`;
        }
    }
    const d = val instanceof Date ? val : new Date(String(val));
    if (!Number.isNaN(d.getTime())) {
        const dd = String(d.getDate()).padStart(2, "0");
        const mm = String(d.getMonth() + 1).padStart(2, "0");
        const yyyy = d.getFullYear();
        return `${dd}/${mm}/${yyyy}`;
    }
    return String(val);
};

const educationHeader = (lines: string) => (
    <Box
        component="span"
        sx={{ whiteSpace: "pre-line", lineHeight: "normal", fontWeight: 400, fontSize: 14 }}
    >
        {lines}
    </Box>
);

const educationalColumn = (
    field: string,
    headerName: string,
    headerLines: string,
    flex: number
) => ({
    field,
    headerName,
    renderHeader: () => educationHeader(headerLines),
    flex,
    minWidth: Math.min(flex, 80),
    sortable: false,
    filterable: false,
});

const certificationDateColumn = (
    field: "ProviderTrainingCertifiedDate" | "ProviderTrainingExipryDate",
    headerName: string,
    editable: boolean,
    flex: number,
    minWidth?: number
) => ({
    field,
    headerName,
    editable,
    type: "date" as const,
    flex,
    ...(minWidth != null ? { minWidth } : {}),
    valueGetter: (value: unknown, row: Record<string, unknown>) =>
        toGridDate(value !== undefined && value !== null ? value : row?.[field]),
    valueFormatter: (value: unknown) => formatDateToDDMMYYYY(value),
});

