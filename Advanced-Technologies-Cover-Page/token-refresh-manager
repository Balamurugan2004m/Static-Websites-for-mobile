"use client";

import { useAuth } from "@/hooks/useAuth";
import { usePathname } from "next/navigation";
import { useCallback, useEffect, useRef } from "react";
import { refreshToken } from "@/services/auth/auth-service";
import {
  getJwtExpiryMs,
  isJwtExpired,
  shouldRefreshJwt,
} from "@/lib/auth/jwt-utils";
import { logoutDueToExpiredJwt } from "@/lib/auth/logout-expired-jwt";
import { isAuthPublicPath } from "@/lib/auth/auth-public-paths";
import {
  LAST_ACTIVITY_KEY,
  resolveSessionTiming,
} from "@/lib/auth/session-timeout-config";

const DEFAULT_REFRESH_BEFORE_MS = 90_000;
const REFRESH_POLL_MS = 30_000;

function resolveRefreshBeforeMs(): number {
  const configured = Number(process.env.NEXT_PUBLIC_JWT_REFRESH_BEFORE_MS);
  return Number.isFinite(configured) && configured > 0
    ? configured
    : DEFAULT_REFRESH_BEFORE_MS;
}

const REFRESH_BEFORE_MS = resolveRefreshBeforeMs();
const { timeoutMs: SESSION_TIMEOUT_MS } = resolveSessionTiming();

function readStoredToken(): string {
  if (typeof window === "undefined") {
    return "";
  }
  return window.localStorage.getItem("accessToken") ?? "";
}

function readLastActivityAt(fallback: number): number {
  if (typeof window === "undefined") {
    return fallback;
  }
  const parsed = Number(window.localStorage.getItem(LAST_ACTIVITY_KEY));
  return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;
}

function writeAccessTokenCookie(token: string): void {
  const expires = new Date();
  expires.setDate(expires.getDate() + 7);
  document.cookie = `accessToken=${token}; Path=/; Expires=${expires.toUTCString()}; SameSite=Lax`;
}

export function TokenRefreshManager() {
  const pathname = usePathname();
  const { accessToken, setAuthAccessToken } = useAuth();
  const refreshingRef = useRef(false);
  const loggingOutRef = useRef(false);
  const expiryTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const setAuthAccessTokenRef = useRef(setAuthAccessToken);

  setAuthAccessTokenRef.current = setAuthAccessToken;

  const hasToken = Boolean(accessToken) || Boolean(readStoredToken());
  const isLoginPage = pathname === "/login" || pathname === "/login/";
  const isAuthenticated = hasToken && !isLoginPage;

  const forceLogout = useCallback(() => {
    if (loggingOutRef.current || isAuthPublicPath(pathname)) {
      return;
    }
    loggingOutRef.current = true;
    logoutDueToExpiredJwt();
  }, [pathname]);

  const scheduleExpiryLogout = useCallback(
    (token: string) => {
      if (expiryTimerRef.current) {
        clearTimeout(expiryTimerRef.current);
        expiryTimerRef.current = null;
      }

      const expiryMs = getJwtExpiryMs(token);
      if (expiryMs === null) {
        return;
      }

      const delayMs = expiryMs - Date.now() + 250;
      if (delayMs <= 0) {
        forceLogout();
        return;
      }

      expiryTimerRef.current = setTimeout(() => {
        const current = readStoredToken();
        if (!current || isJwtExpired(current)) {
          forceLogout();
        }
      }, delayMs);
    },
    [forceLogout]
  );

  const tryRefresh = useCallback(async () => {
    if (refreshingRef.current || loggingOutRef.current) {
      return;
    }

    const token = accessToken || readStoredToken();
    if (!token) {
      return;
    }

    const nowMs = Date.now();

    if (isJwtExpired(token, nowMs)) {
      forceLogout();
      return;
    }

    scheduleExpiryLogout(token);

    const lastActivityAt = readLastActivityAt(nowMs);

    if (
      !shouldRefreshJwt({
        token,
        refreshBeforeMs: REFRESH_BEFORE_MS,
        lastActivityAt,
        sessionTimeoutMs: SESSION_TIMEOUT_MS,
        nowMs,
      })
    ) {
      return;
    }

    refreshingRef.current = true;
    try {
      const response = await refreshToken();
      if (response?.Token) {
        setAuthAccessTokenRef.current(response.Token);
        writeAccessTokenCookie(response.Token);
        scheduleExpiryLogout(response.Token);
      } else {
        forceLogout();
      }
    } catch (error) {
      console.error("JWT refresh failed", error);
      // If refresh fails while near/at expiry, end the session.
      if (isJwtExpired(readStoredToken() || token) || isJwtExpired(token)) {
        forceLogout();
      } else {
        // Near-expiry refresh failed; token may still be briefly valid — force logout for safety.
        forceLogout();
      }
    } finally {
      refreshingRef.current = false;
    }
  }, [accessToken, forceLogout, scheduleExpiryLogout]);

  useEffect(() => {
    if (!isAuthenticated) {
      loggingOutRef.current = false;
      if (expiryTimerRef.current) {
        clearTimeout(expiryTimerRef.current);
        expiryTimerRef.current = null;
      }
      return;
    }

    void tryRefresh();
    const intervalId = window.setInterval(() => {
      void tryRefresh();
    }, REFRESH_POLL_MS);

    return () => {
      window.clearInterval(intervalId);
      if (expiryTimerRef.current) {
        clearTimeout(expiryTimerRef.current);
        expiryTimerRef.current = null;
      }
    };
  }, [isAuthenticated, tryRefresh]);

  return null;
}
