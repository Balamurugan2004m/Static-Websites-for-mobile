/* eslint-disable @typescript-eslint/no-explicit-any */
import React, { useState } from "react";
import KeyboardArrowDownIcon from "@mui/icons-material/KeyboardArrowDown";
import {
  FormControl,
  Select,
  MenuItem,
  TextField,
  Typography,
  Box,
  useTheme,
  Chip,
} from "@mui/material";
import "../users.css";
import { THEME_PRIMITIVES } from "../../../theme";
import { fieldErrorTextStyle, dropdownScrollbarSx } from "../utils/style-tokens";

interface SearchableSelectProps {
  label?: string;
  dataField?: string;
  options: any[];
  value: string | string[];
  onChange: (value: string | string[]) => void;
  placeholder?: string;
  fullWidth?: boolean;
  minWidth?: number;
  isDarkMode?: boolean;
  readOnly?: boolean;
  isMulti?: boolean;
  isCluster?: boolean;
  error?: string;
  disabled?: boolean;
  accountUsersForm?: boolean;
}

const SearchableSelect: React.FC<SearchableSelectProps> = ({
  dataField,
  options = [],
  value,
  disabled = false,
  onChange,
  placeholder = "Select...",
  fullWidth = true,
  minWidth = 200,
  readOnly = false,
  isMulti = false,
  isCluster = false,
  error = "",
  accountUsersForm = false,
}) => {
  const [search, setSearch] = useState("");
  const theme = useTheme();
  const P = THEME_PRIMITIVES;
  const dropdownScrollSx = dropdownScrollbarSx(theme.palette.mode === "dark");

  const getOptionLabel = (opt: any): string =>
    String(opt?.keyValue ?? opt?.Description ?? opt?.Name ?? opt?.FullName ?? "");

  const getOptionId = (opt: any): string | number =>
    opt?.keyValueId ?? opt?.Id ?? opt?.UserName ?? "";

  const filteredOptions = options.filter((opt) => {
    const label =
      typeof opt === "string" ? opt : getOptionLabel(opt);
    return label.toLowerCase().includes(search.toLowerCase());
  });
  const hasZeroOption = options.some(
    (opt) => String(getOptionId(opt)) === "0"
  );
  const isZeroOrEmpty = (v: any) =>
    v == null || // null or undefined
    v === "" ||
    ((v === 0 || v === "0") && !hasZeroOption) ||
    (typeof v === "string" && v.trim().length === 0);

  const isEmpty = isMulti
    ? !Array.isArray(value) || value.length === 0
    : isZeroOrEmpty(value);

  const normalizedValue = isMulti
    ? (Array.isArray(value) ? value.map(String) : [])
    : isZeroOrEmpty(value)
      ? ""
      : String(value);
  const hasClusterChips =
    isCluster && Array.isArray(normalizedValue) && normalizedValue.length > 0;
  const controlHeight = hasClusterChips ? "auto" : "32px";
  const controlPadding = "8px 32px 8px 14px !important";
  const selectedBg =
    theme.palette.mode === "dark"
      ? `${P.inputBgDark} !important`
      : `${P.gridHeaderLight} !important`;
  const hoverBg =
    theme.palette.mode === "dark"
      ? `${P.inputBgDark} !important`
      : `${theme.custom?.colors.gridHeaderBg ?? P.gridHeaderLight} !important`;
  const isOptionSelected = (id: string | number) => {
    const idStr = String(id);
    if (Array.isArray(normalizedValue)) {
      return normalizedValue.includes(idStr);
    }
    return String(normalizedValue) === idStr;
  };

  return (
    <FormControl
      fullWidth={fullWidth}
      sx={{
        minWidth,
        width: "100%",
        m: 0,
        mt: 0,
        mb: 0,
        p: 0,
        verticalAlign: "top",
        "& .MuiInputBase-root": {
          margin: 0,
          padding: 0,
        },
      }}
    >
      <Select
        name={dataField}
        inputProps={{ "data-field": dataField }}
        multiple={isMulti}
        value={normalizedValue}
        onChange={(e) => {
          onChange(e.target.value);
          setSearch("");
        }}
        displayEmpty
        disabled={disabled && !readOnly}
        readOnly={readOnly}
        size={accountUsersForm ? "small" : "medium"}
        IconComponent={KeyboardArrowDownIcon}
        renderValue={(selected) => {
          if (!selected || (selected === "0" && !hasZeroOption) || (Array.isArray(selected) && selected.length === 0)) {
            return (
              <Typography
                sx={{
                  color:
                    theme.palette.mode === "dark"
                      ? `${P.lightMutedText} !important`
                      : "#757575",
                  fontSize: "14px",
                }}
              >
                {placeholder}
              </Typography>
            );
          }
          if (Array.isArray(selected)) {
            return (
              <Box sx={{ display: "flex", flexWrap: "wrap", gap: 0.5 }}>
                {selected.map((val) => {
                  const match = options?.find(
                    (e) => String(getOptionId(e)) === String(val)
                  );
                  const label = match ? getOptionLabel(match) : String(val);
                  return (
                    <Chip
                      key={String(val)}
                      label={label}
                      size="small"
                      sx={{
                        maxWidth: 120,
                        "& .MuiChip-label": {
                          display: "block",
                          overflow: "hidden",
                          textOverflow: "ellipsis",
                          whiteSpace: "nowrap",
                        },
                      }}
                      title={label}
                    />
                  );
                })}
              </Box>
            );
          }
          const selectedOption = options?.find(
            (e) => String(getOptionId(e)) === String(selected)
          );
          if (selectedOption) {
            return getOptionLabel(selectedOption);
          }
          return (
            <Typography
              sx={{
                color:
                  theme.palette.mode === "dark"
                    ? `${P.lightMutedText} !important`
                    : "#757575",
                fontSize: "14px",
              }}
            >
              {placeholder}
            </Typography>
          );
        }}
        sx={{
          height: controlHeight,
          minHeight: "32px",
          boxSizing: "border-box",
          borderRadius: "10px",
          margin: 0,
          padding: 0,
          cursor: readOnly || disabled ? "not-allowed !important" : "pointer",
          "&.Mui-disabled": {
            cursor: "not-allowed !important",
            pointerEvents: "auto !important",
          },
          "& .Mui-disabled": {
            cursor: "not-allowed !important",
          },
          "& .MuiSelect-select.Mui-disabled": {
            cursor: "not-allowed !important",
          },
          "& .MuiInputBase-input.Mui-disabled": {
            cursor: "not-allowed !important",
          },
          "& .MuiOutlinedInput-root.Mui-disabled": {
            cursor: "not-allowed !important",
          },
          "& .MuiOutlinedInput-notchedOutline": {
            border: "none",
          },
          backgroundColor: accountUsersForm
            ? theme.palette.mode === "dark"
              ? `${P.secondaryElevatedDark} !important`
              : P.white
            : ["ProfessionalTitle", ].includes(dataField ?? "") &&
          !readOnly
            ? theme.palette.mode === "dark"
              ? `${P.inputBgDark} !important`
              : P.white
            : theme.palette.mode === "dark"
              ? `${P.gridHeaderDark} !important`
              : P.gridHeaderLight,
             border: `1px solid ${
            accountUsersForm
              ? theme.palette.mode === "dark"
                ? `${P.selectBorderDark} !important`
                : "#787878"
              : theme.palette.mode === "dark"
              ? isEmpty
                ? P.emptyInputBorderDark
                : P.labelMuted
              : isEmpty
              ? P.inputBorderLightSoft
              : `${P.selectBorderDark} !important`
          }`,
          ...(accountUsersForm && !readOnly
            ? {
                "&.Mui-focused, &.Mui-expanded": {
                  border: `1px solid ${P.primary} !important`,
                },
              }
            : {}),
          // "& .MuiOutlinedInput-notchedOutline": {
          //   border: "none",
          // },
          "& .MuiSelect-icon": {
            pointerEvents: "none",
            color: theme.palette.mode === "dark" ? P.selectBorderDark : (accountUsersForm ? "#787878" : P.labelMuted),
          },
          "& .MuiSelect-select": {
            color: theme.palette.mode === "dark" ? theme.palette.text.primary : P.black,
            padding: controlPadding,
            height: hasClusterChips ? "auto" : "32px",
            minHeight: "32px !important",
            lineHeight: "16px",
            display: "flex",
            alignItems: "center",
            fontSize: "14px",
            fontWeight: 400,
            overflow: "hidden",
            textOverflow: "ellipsis",
            whiteSpace: hasClusterChips ? "normal" : "nowrap",
            boxSizing: "border-box",
          },
          "& .MuiInputBase-input": {
            padding: controlPadding,
            height: hasClusterChips ? "auto" : "32px",
            minHeight: "32px !important",
            lineHeight: "16px",
            boxSizing: "border-box",
          },
        }}
        MenuProps={{
          disableScrollLock: true,
          slotProps: {
            paper: {
              sx: {
                borderRadius: "10px",
                border: `1px solid ${
                  theme.palette.mode === "dark" ? `${P.primary} !important` : P.primary
                }`,
                background: theme.palette.mode === "dark" ? `${P.secondaryElevatedDark} !important` : P.white,
                backgroundColor: theme.palette.mode === "dark" ? `${P.secondaryElevatedDark} !important` : P.white,
                bgcolor: theme.palette.mode === "dark" ? `${P.secondaryElevatedDark} !important` : P.white,
                maxHeight: 300,
                overflowY: "auto",
                ...dropdownScrollSx,
                "& .MuiList-root": {
                  paddingTop: 0,
                  paddingBottom: 0,
                  maxHeight: 250,
                  overflowY: "auto",
                  background: theme.palette.mode === "dark" ? `${P.secondaryElevatedDark} !important` : P.white,
                  backgroundColor: theme.palette.mode === "dark" ? `${P.secondaryElevatedDark} !important` : P.white,
                  ...dropdownScrollSx,
                },
                "& .MuiSvgIcon-root": {
                  color: theme.palette.mode === "dark" ? P.mutedBorder : P.labelMuted,
                },
                "& .MuiMenuItem-root": {
                  fontSize: "14px",
                  fontWeight: 400,
                  backgroundColor: theme.palette.mode === "dark" ? `${P.secondaryElevatedDark} !important` : P.white,
                  border: `1px solid ${
                    theme.palette.mode === "dark"
                      ? `${theme.custom?.colors.providerLayout.refreshHoverDark} !important`
                      : theme.custom?.colors.stroke
                  }`,
                  "&:last-child": { borderBottom: "none" },
                  "&:hover, &.Mui-focusVisible": {
                    backgroundColor: hoverBg,
                  },
                  "&.Mui-selected": {
                    backgroundColor: selectedBg,
                    fontWeight: 600,
                  },
                  "&.Mui-selected:hover, &.Mui-selected.Mui-focusVisible": {
                    backgroundColor: hoverBg,
                  },
                },
              },
            },
          },
          PaperProps: {
            sx: {
              borderRadius: "10px",
              background: theme.palette.mode === "dark" ? `${P.secondaryElevatedDark} !important` : P.white,
              backgroundColor: theme.palette.mode === "dark" ? `${P.secondaryElevatedDark} !important` : P.white,
              bgcolor: theme.palette.mode === "dark" ? `${P.secondaryElevatedDark} !important` : P.white,
            },
          },
          anchorOrigin: {
            vertical: "bottom",
            horizontal: "left",
          },
          transformOrigin: {
            vertical: "top",
            horizontal: "left",
          },
        }}
      >
        {/* Search input inside dropdown */}
        <Box sx={{ px: 2, py: 1 }} onClick={(e) => e.stopPropagation()}>
          <TextField
            placeholder="Search..."
            id="search-select"
            size="small"
            fullWidth
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            onClick={(e) => e.stopPropagation()}
            onKeyDown={(e) => e.stopPropagation()}
            sx={{
            "& .MuiOutlinedInput-root": {
              height: "40px",
              borderRadius: "6px",

              backgroundColor:
                theme.palette.mode === "dark"
                  ? P.secondaryElevatedDark
                  : theme.custom?.colors.gridHeaderBg,

              "& fieldset": {
                border: `1px solid ${
                  theme.palette.mode === "dark"
                    ? theme.custom?.colors.providerLayout.refreshHoverDark
                    : theme.custom?.colors.providerLayout.refreshHoverLight
                }`,
              },

              "&:hover fieldset": {
                border: `1px solid ${
                  theme.palette.mode === "dark"
                    ? theme.custom?.colors.providerLayout.refreshHoverDark
                    : theme.custom?.colors.providerLayout.refreshHoverLight
                }`,
              },

              "&.Mui-focused fieldset": {
                border: `1px solid ${
                  theme.palette.mode === "dark"
                    ? theme.custom?.colors.providerLayout.refreshHoverDark
                    : theme.custom?.colors.providerLayout.refreshHoverLight
                } !important`,
              },
            },

    "& .MuiInputBase-input": {
      color:
        theme.palette.mode === "dark"
          ?  P.white
          :  P.darkSurfacePrimary,

      fontSize: "14px",
      padding: "10px 12px",
    },

    "& .MuiInputBase-input::placeholder": {
      color:
        theme.palette.mode === "dark"
          ? P.mutedBorder
          : P.neutralGray,

      opacity: 1,
    },
  }}
          />
        </Box>
        {/* Filtered results */}
        {filteredOptions.length > 0 ? (
          filteredOptions.map((opt, i) => {
            const id = typeof opt === "string" ? opt : getOptionId(opt);
            const label = typeof opt === "string" ? opt : getOptionLabel(opt);
            const idStr = String(id);
            return (
              <MenuItem
                key={`${idStr}-${i}`}
                value={idStr}
                selected={isOptionSelected(idStr)}
                onClick={() => {
                  if (isMulti) {
                    const currentArr = Array.isArray(value) ? value.map(String) : [];
                    const next = currentArr.includes(idStr)
                      ? currentArr.filter((item) => item !== idStr)
                      : [...currentArr, idStr];
                    onChange(next);
                  } else {
                    onChange(idStr);
                  }
                  setSearch("");
                }}
              >
                {label}
              </MenuItem>
            );
          })
        ) : (
          <MenuItem disabled value="__no_results__">
            No results
          </MenuItem>
        )}
      </Select>
      {error && (
        <div style={fieldErrorTextStyle(theme.palette.error.main)}>
          {error}
        </div>
      )}
    </FormControl>
  );
};

export default SearchableSelect;
