import React from "react";
import { render, screen, fireEvent } from "@testing-library/react";
import { ThemeProvider, createTheme } from "@mui/material/styles";
import AddUser from "./add-user";

import { useDispatch, useSelector } from "react-redux";
import { useNavigate } from "react-router";
import {
  fetchAccountUserData,
  createAccountUser,
} from "../../store/slice/account-users-slice";
import { showToast } from "../../utils/toast";
import { TOAST_TYPES } from "../../types/toast-types";

// --------------------
// Mocks
// --------------------
jest.mock("react-redux", () => ({
  useDispatch: jest.fn(),
  useSelector: jest.fn(),
}));

jest.mock("react-router", () => ({
  useNavigate: jest.fn(),
}));

jest.mock("../../store/slice/account-users-slice", () => ({
  fetchAccountUserData: jest.fn(() => ({ type: "FETCH" })),
  createAccountUser: jest.fn(),
}));

jest.mock("react-toastify", () => ({
  toast: {
    success: jest.fn(),
    error: jest.fn(),
  },
}));

jest.mock("../../utils/toast", () => ({
  showToast: jest.fn(),
}));

// FIXED SELECT MOCK (important fix)
jest.mock("../../components/users/components/select-filed", () => ({
  __esModule: true,
  default: ({ field, value, onChange, isMulti }: any) => {
    const safeValue = isMulti
      ? Array.isArray(value)
        ? value
        : []
      : Array.isArray(value)
      ? value[0] || ""
      : value || "";

    return (
      <select
        data-testid={`select-${field}`}
        multiple={!!isMulti}
        value={safeValue}
        onChange={(e) =>
          onChange(field, isMulti ? [e.target.value] : e.target.value)
        }
      >
        <option value="">--Select--</option>
        <option value="1">Option1</option>
        <option value="2">Option2</option>
      </select>
    );
  },
}));

jest.mock("../../components/users/components/form-field", () => ({
  __esModule: true,
  default: ({ field, value, onChange, required, label }: any) => (
    <input
      name={field}
      data-testid={`input-${field}`}
      data-required={required ? "true" : "false"}
      aria-label={label}
      value={value || ""}
      onChange={(e) => onChange(field, e.target.value)}
    />
  ),
}));

// FIXED HEADER MOCK (add title)
jest.mock("../../components/users/components/header-with-edit-actions", () => ({
  __esModule: true,
  default: ({ onSave, onCancel, title }: any) => (
    <div>
      <h1>{title}</h1>
      <button onClick={onSave}>Save</button>
      <button onClick={onCancel}>Cancel</button>
    </div>
  ),
}));

jest.mock("../../components/users/components/skeleton-loader", () => ({
  __esModule: true,
  default: () => <div>Loading user data</div>,
}));

jest.mock("../../components/app-tooltip", () => ({
  __esModule: true,
  default: ({ children }: any) => <div>{children}</div>,
}));

jest.mock("../../components/page-title-chip", () => ({
  __esModule: true,
  default: ({ title, onClick }: any) => (
    <div onClick={onClick}>{title}</div>
  ),
}));

jest.mock("../../ui", () => ({
  ConfirmationModal: ({ open, title, highlightMessage, onConfirm, onCancel, confirmLabel, cancelLabel }: any) =>
    open ? (
      <div data-testid="confirmation-modal">
        <span>Modal Open</span>
        <div data-testid="modal-title">{title}</div>
        <div data-testid="modal-highlight">{highlightMessage}</div>
        <button data-testid="modal-confirm" onClick={onConfirm}>
          {confirmLabel || "Yes"}
        </button>
        <button data-testid="modal-cancel" onClick={onCancel}>
          {cancelLabel || "No"}
        </button>
      </div>
    ) : null,
}));

Element.prototype.scrollIntoView = jest.fn();

// --------------------
// Setup
// --------------------
const theme = createTheme({ palette: { mode: "light" } });

const renderWithTheme = (ui: React.ReactElement) =>
  render(<ThemeProvider theme={theme}>{ui}</ThemeProvider>);

const baseState = {
  accountUsers: {
    managers: [{ UserName: "m1", FullName: "Manager", UserId: 1 }],
    clusters: [{ Id: 1, Description: "Cluster1" }],
    userRoles: [{ ApplicationRoleId: "r1", Name: "Admin" }],
    lookUpValues: [{ LookupValueId: 1, Description: "Skill1" }],
    skillsOption: ["Skill1"],
    isLoading: false,
  },
  theme: { mode: "light" },
} as any;

// --------------------
// Tests
// --------------------
describe("AddUser Fixed Suite", () => {
  const dispatchMock = jest.fn();
  const navigateMock = jest.fn();

  beforeEach(() => {
    navigateMock.mockClear();
    dispatchMock.mockClear();
    (useDispatch as unknown as jest.Mock).mockReturnValue(dispatchMock);
    (useSelector as unknown as jest.Mock).mockImplementation((sel: any) => sel(baseState));
    (useNavigate as unknown as jest.Mock).mockReturnValue(navigateMock);
  });

  it("renders header title", () => {
    renderWithTheme(<AddUser />);
    expect(screen.getByRole("heading", { name: "Add User" })).toBeInTheDocument();
  });

  it("renders Users chip", () => {
    renderWithTheme(<AddUser />);
    expect(screen.getByText("Users")).toBeInTheDocument();
  });

  it("shows loader when loading", () => {
    (useSelector as unknown as jest.Mock).mockImplementation((sel: any) =>
      sel({
        ...baseState,
        accountUsers: { ...baseState.accountUsers, isLoading: true },
      })
    );
    renderWithTheme(<AddUser />);
    expect(screen.getByText(/Loading user data/i)).toBeInTheDocument();
  });

  it("dispatches fetch when no data", () => {
    (useSelector as unknown as jest.Mock).mockImplementation((sel: any) =>
      sel({
        ...baseState,
        accountUsers: { managers: [], clusters: [], userRoles: [], lookUpValues: [] },
      })
    );
    renderWithTheme(<AddUser />);
    expect(fetchAccountUserData).toHaveBeenCalled();
  });

  it("handles input change", () => {
    renderWithTheme(<AddUser />);
    const input = document.querySelector<HTMLInputElement>('input[name="FirstName"]')!;
    fireEvent.change(input, { target: { value: "John" } });
    expect(input.value).toBe("John");
  });

  it("handles select change", () => {
    renderWithTheme(<AddUser />);
    const select = screen.getByTestId("select-UserTypeId");
    fireEvent.change(select, { target: { value: "1" } });
    expect(select).toBeInTheDocument();
  });

  it("handles multi select safely", () => {
    renderWithTheme(<AddUser />);
    const select = screen.getByTestId("select-ClusterLookupValueMappings");
    fireEvent.change(select, { target: { value: "1" } });
    expect(select).toBeInTheDocument();
  });

  it("handles save click without crash", () => {
    renderWithTheme(<AddUser />);
    fireEvent.click(screen.getByText(/Save/i));
    expect(screen.getByRole("heading", { name: "Add User" })).toBeInTheDocument();
  });

  it("handles cancel navigation", () => {
    renderWithTheme(<AddUser />);
    fireEvent.click(screen.getByText(/Cancel/i));
    expect(navigateMock).toHaveBeenCalled();
  });

  it("handles Users navigation", () => {
    renderWithTheme(<AddUser />);
    fireEvent.click(screen.getByText("Users"));
    expect(navigateMock).toHaveBeenCalled();
  });

  it("handles modal open", () => {
    renderWithTheme(<AddUser />);
    fireEvent.click(screen.getAllByRole("button")[0]);
    expect(screen.getByText(/Modal Open/i)).toBeInTheDocument();
  });

  it("handles resize", () => {
    renderWithTheme(<AddUser />);
    fireEvent(window, new Event("resize"));
    expect(screen.getByRole("heading", { name: "Add User" })).toBeInTheDocument();
  });

  it("cleans resize listener", () => {
    const spy = jest.spyOn(window, "removeEventListener");
    const { unmount } = renderWithTheme(<AddUser />);
    unmount();
    expect(spy).toHaveBeenCalled();
  });

  it("renders all inputs", () => {
    renderWithTheme(<AddUser />);
    expect(document.querySelectorAll("input").length).toBeGreaterThan(0);
  });

  it("renders all selects", () => {
    renderWithTheme(<AddUser />);
    expect(document.querySelectorAll("select").length).toBeGreaterThan(0);
  });

  it("handles multiple renders", () => {
    const { rerender } = renderWithTheme(<AddUser />);
    rerender(
      <ThemeProvider theme={theme}>
        <AddUser />
      </ThemeProvider>
    );
    expect(screen.getByRole("heading", { name: "Add User" })).toBeInTheDocument();
  });

  it("does not crash on empty values", () => {
    renderWithTheme(<AddUser />);
    expect(screen.getByRole("heading", { name: "Add User" })).toBeInTheDocument();
  });

  it("handles role select", () => {
    renderWithTheme(<AddUser />);
    fireEvent.change(screen.getByTestId("select-Roles"), {
      target: { value: "1" },
    });
  });

  it("handles manager select", () => {
    renderWithTheme(<AddUser />);
    fireEvent.change(screen.getByTestId("select-ManagerId"), {
      target: { value: "1" },
    });
  });

  it("handles skill select", () => {
    renderWithTheme(<AddUser />);
    fireEvent.change(screen.getByTestId("select-SkillLevel"), {
      target: { value: "1" },
    });
  });

  it("marks Print Name, City, State, and ZIP Code as required", () => {
    renderWithTheme(<AddUser />);
    expect(document.querySelector('input[name="PrintName"]')).toHaveAttribute("data-required", "true");
    expect(document.querySelector('input[name="City"]')).toHaveAttribute("data-required", "true");
    expect(document.querySelector('input[name="State"]')).toHaveAttribute("data-required", "true");
    expect(document.querySelector('input[name="Zip"]')).toHaveAttribute("data-required", "true");
  });

  it("shows validation error on pre-save when Print Name is empty", () => {
    renderWithTheme(<AddUser />);
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="FirstName"]')!, { target: { value: "John" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="LastName"]')!, { target: { value: "Doe" } });
    fireEvent.click(screen.getByText(/Save/i));
    expect(showToast).toHaveBeenCalledWith("Print name is required", TOAST_TYPES.ERROR);
    expect(createAccountUser).not.toHaveBeenCalled();
  });

  it("shows validation error on pre-save when City is empty", () => {
    renderWithTheme(<AddUser />);
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="FirstName"]')!, { target: { value: "John" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="LastName"]')!, { target: { value: "Doe" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="PrintName"]')!, { target: { value: "John Doe" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="Email"]')!, { target: { value: "john@example.com" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="UserName"]')!, { target: { value: "johndoe" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="AddressLine1"]')!, { target: { value: "123 Main St" } });
    fireEvent.click(screen.getByText(/Save/i));
    expect(showToast).toHaveBeenCalledWith("City is required", TOAST_TYPES.ERROR);
    expect(createAccountUser).not.toHaveBeenCalled();
  });

  it("shows validation error on pre-save when State is empty", () => {
    renderWithTheme(<AddUser />);
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="FirstName"]')!, { target: { value: "John" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="LastName"]')!, { target: { value: "Doe" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="PrintName"]')!, { target: { value: "John Doe" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="Email"]')!, { target: { value: "john@example.com" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="UserName"]')!, { target: { value: "johndoe" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="AddressLine1"]')!, { target: { value: "123 Main St" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="City"]')!, { target: { value: "Austin" } });
    fireEvent.click(screen.getByText(/Save/i));
    expect(showToast).toHaveBeenCalledWith("State is required", TOAST_TYPES.ERROR);
    expect(createAccountUser).not.toHaveBeenCalled();
  });

  it("shows validation error on pre-save when ZIP Code is empty", () => {
    renderWithTheme(<AddUser />);
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="FirstName"]')!, { target: { value: "John" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="LastName"]')!, { target: { value: "Doe" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="PrintName"]')!, { target: { value: "John Doe" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="Email"]')!, { target: { value: "john@example.com" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="UserName"]')!, { target: { value: "johndoe" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="AddressLine1"]')!, { target: { value: "123 Main St" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="City"]')!, { target: { value: "Austin" } });
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="State"]')!, { target: { value: "TX" } });
    fireEvent.click(screen.getByText(/Save/i));
    expect(showToast).toHaveBeenCalledWith("ZIP Code is required", TOAST_TYPES.ERROR);
    expect(createAccountUser).not.toHaveBeenCalled();
  });

  it("navigates directly to users list when Cancel is clicked on pristine form without unsaved changes", () => {
    renderWithTheme(<AddUser />);
    fireEvent.click(screen.getByText(/Cancel/i));
    expect(navigateMock).toHaveBeenCalledWith("/configuration/users");
    expect(screen.queryByTestId("confirmation-modal")).not.toBeInTheDocument();
  });

  it("shows unsaved changes warning modal when Cancel is clicked on dirty form", () => {
    renderWithTheme(<AddUser />);
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="FirstName"]')!, {
      target: { value: "Sagio" },
    });
    fireEvent.click(screen.getByText(/Cancel/i));

    expect(screen.getByTestId("confirmation-modal")).toBeInTheDocument();
    expect(screen.getByTestId("modal-title")).toHaveTextContent("Warning!");
    expect(screen.getByTestId("modal-highlight")).toHaveTextContent(/You have unsaved changes/i);
    expect(navigateMock).not.toHaveBeenCalled();
  });

  it("closes modal and stays on page when Cancel/No is selected in unsaved changes modal", () => {
    renderWithTheme(<AddUser />);
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="FirstName"]')!, {
      target: { value: "Sagio" },
    });
    fireEvent.click(screen.getByText(/Cancel/i));
    expect(screen.getByTestId("confirmation-modal")).toBeInTheDocument();

    fireEvent.click(screen.getByTestId("modal-cancel"));
    expect(screen.queryByTestId("confirmation-modal")).not.toBeInTheDocument();
    expect(navigateMock).not.toHaveBeenCalled();
    expect(document.querySelector<HTMLInputElement>('input[name="FirstName"]')?.value).toBe("Sagio");
  });

  it("discards changes and navigates away when Yes is selected in unsaved changes modal", () => {
    renderWithTheme(<AddUser />);
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="FirstName"]')!, {
      target: { value: "Sagio" },
    });
    fireEvent.click(screen.getByText(/Cancel/i));

    fireEvent.click(screen.getByTestId("modal-confirm"));
    expect(navigateMock).toHaveBeenCalledWith("/configuration/users");
  });

  it("shows unsaved changes warning modal when clicking top bar Users chip on dirty form", () => {
    renderWithTheme(<AddUser />);
    fireEvent.change(document.querySelector<HTMLInputElement>('input[name="PrintName"]')!, {
      target: { value: "Sagio Lealofi" },
    });

    fireEvent.click(screen.getByText("Users"));
    expect(screen.getByTestId("confirmation-modal")).toBeInTheDocument();
    expect(screen.getByTestId("modal-title")).toHaveTextContent("Warning!");
  });
});
